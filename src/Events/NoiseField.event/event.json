  "shaderBundle": "assets/noise-field.bundle",
  "includedEvents": [
    "included/state.json"
  ],
  "vectorPrograms": {
    "palette": "workers/palette.js",
    "contacts": "workers/contacts.js",
    "bake": "workers/legacy-bake.js",
    "bakePlan": "workers/legacy-plan.js"
  },
  "computeGraphs": {
    "coverage": "pipelines/coverage.json"
  },
  "keySpecs": {
    "frames": "pipelines/cpu-key.json"
  },
  "runtimeBindings": {
    "renderGraph": "coverage",
    "inputController": "contacts",
    "colorProgram": "palette",
    "framePlan": "bakePlan",
    "frameProgram": "bake",
    "frameKey": "frames"
  },
  "pixelResources": {
    "block": "assets/legacy/block.png",
    "point": "assets/legacy/point.png"
  },
  "shaderAssets": {
    "compute": "assets/noisefieldcoverage.compute",
    "disabled": "assets/generated/PEVNoise_100_disabled.shader",
    "activeCapture": "assets/generated/PEVNoise_000_capture.shader",
    "hoverCapture": "assets/generated/PEVNoise_010_capture.shader",
    "activeNoCapture": "assets/generated/PEVNoise_000_nocapture.shader",
    "hoverNoCapture": "assets/generated/PEVNoise_010_nocapture.shader",
    "disabledColored": "assets/generated/PEVNoise_101_disabled.shader",
    "activeCaptureColored": "assets/generated/PEVNoise_001_capture.shader",
    "hoverCaptureColored": "assets/generated/PEVNoise_011_capture.shader",
    "activeNoCaptureColored": "assets/generated/PEVNoise_001_nocapture.shader",
    "hoverNoCaptureColored": "assets/generated/PEVNoise_011_nocapture.shader"
  },
  "imageAssets": {
    "displacement": {
      "path": "assets/BlockNoise1.png",
      "wrap": "mirror",
      "filter": "point",
      "flipY": true,
      "linear": true
    },
    "spark": {
      "path": "assets/PointNoise.png",
      "wrap": "repeat",
      "filter": "point",
      "flipY": true,
      "linear": true
    },
    "noise": {
      "path": "assets/FD_Noise_00000.png",
      "wrap": "mirror",
      "filter": "point",
      "flipY": true,
      "linear": true
    },
    "touch": {
      "path": "assets/TouchHover.png",
      "wrap": "clamp",
      "filter": "linear",
      "flipY": true,
      "linear": true
    }
  }

    },
    {
      "name": "edgeDetail",
      "type": "Float",
      "default": 8,
      "min": 1,
      "max": 32,
      "group": "Deprecated",
      "order": 121,
      "label": {
        "en": "Edge Detail (legacy, deprecated)",

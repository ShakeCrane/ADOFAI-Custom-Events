    {
      "name": "exposure",
      "type": "Float",
      "default": 0.15,
      "min": 0,
      "max": 2,
      "group": "Deprecated",
      "order": 126,
      "label": {
        "en": "Background Exposure (legacy, deprecated)",
        "zh-CN": "背景曝光（旧版弃用）"

{
  "schemaVersion": 4,
  "id": "pev.noise-field",
  "version": "1.22.0",
  "apiVersion": 2,
  "entry": "main.js",
  "icon": "icon.png",
  "category": "DecorationFx",
  "decoration": true,
  "hostPrimitive": "fx.field",
  "fieldPreview": {
    "key": "noisefield",
    "parameterMap": {
      "noiseBrightness": "brightness",
      "noiseSaturation": "saturation",
      "noiseSampleRate": "sampleRate",
      "noiseEvolveSpeed": "evolveSpeed",
      "noiseFrameCount": "frameCount",
      "noiseMoveSpeed": "moveSpeed",
      "noiseScale": "tiling",
      "glitchRange": "glitch"
    }
  },
  "decorationDefaults": {
    "color": "ff5454",
    "tag": "noise"
  },
  "decorationMigration": [
    {
      "source": "size",
      "target": "scale",
      "conversion": "tilesToScale"
    },
    {
      "source": "positionOffset",
      "target": "position",
      "conversion": "vector2"
    },
    {
      "source": "rotation",
      "target": "rotation",
      "conversion": "float"
    },
    {
      "source": "tag",
      "target": "tag",
      "conversion": "string"
    },
    {
      "source": "depth",
      "target": "depth",
      "conversion": "int"
    },
    {
      "source": "opacity",
      "target": "opacity",
      "conversion": "percent"
    },
    {
      "source": "color",
      "target": "color",
      "conversion": "string"
    }
  ],
  "name": {
    "en": "Noise Field",
    "zh-CN": "噪声域"
  },
  "description": {
    "en": "A reference-based GPU noise field. Legacy settings are retained but deprecated.",
    "zh-CN": "参考实现的 GPU 噪域。旧版参数保留数据并标注弃用。"
  },
  "globalSettings": [
    {
      "name": "captureScene",
      "type": "Bool",
      "default": true,
      "label": {
        "en": "Realtime scene sampling (disable for better performance)",
        "zh-CN": "实时场景采样（关闭可提高性能）"
      }
    }
  ],
  "params": [
    {
      "name": "invert",
      "type": "Bool",
      "default": false,
      "group": "Geometry",
      "order": 0,
      "label": {
        "en": "Invert Region",
        "zh-CN": "反转区域"
      }
    },
    {
      "name": "shape",
      "type": "Choice",
      "options": [
        "Rect",
        "Circle"
      ],
      "default": "Rect",
      "group": "Deprecated",
      "order": 100,
      "label": {
        "en": "Shape (legacy, deprecated)",
        "zh-CN": "形状（旧版弃用）"
      },
      "optionLabels": {
        "Rect": {
          "en": "Rectangle",
          "zh-CN": "矩形"
        },
        "Circle": {
          "en": "Circle",
          "zh-CN": "圆形"
        }
      }
    },
    {
      "name": "feather",
      "type": "Float",
      "default": 0,
      "min": 0,
      "max": 8,
      "group": "Deprecated",
      "order": 101,
      "showIf": [
        "shape",
        "Circle"
      ],
      "label": {
        "en": "Circle Softness (legacy, deprecated)",
        "zh-CN": "圆形柔边（旧版弃用）"
      }
    },
    {
      "name": "fillOpacity",
      "type": "Float",
      "default": 0.667,
      "min": 0,
      "max": 1,
      "group": "Deprecated",
      "order": 102,
      "label": {
        "en": "Fill Opacity (legacy, deprecated)",
        "zh-CN": "填充不透明度（旧版弃用）"
      }
    },
    {
      "name": "edgeColor",
      "type": "Color",
      "default": "ff5454",
      "group": "Deprecated",
      "order": 103,
      "label": {
        "en": "Edge Color (legacy, deprecated)",
        "zh-CN": "边框颜色（旧版弃用）"
      }
    },
    {
      "name": "edgeOpacity",
      "type": "Float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "group": "Deprecated",
      "order": 104,
      "label": {
        "en": "Edge Opacity (legacy, deprecated)",
        "zh-CN": "边框不透明度（旧版弃用）"
      }
    },
    {
      "name": "glowColor",
      "type": "Color",
      "default": "ff5454",
      "group": "Deprecated",
      "order": 105,
      "label": {
        "en": "Glow Color (legacy, deprecated)",
        "zh-CN": "辉光颜色（旧版弃用）"
      }
    },
    {
      "name": "glowOpacity",
      "type": "Float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "group": "Deprecated",
      "order": 106,
      "label": {
        "en": "Glow Opacity (legacy, deprecated)",
        "zh-CN": "辉光强度（旧版弃用）"
      }
    },
    {
      "name": "glowPasses",
      "type": "Float",
      "default": 5,
      "min": 0,
      "max": 6,
      "group": "Deprecated",
      "order": 107,
      "label": {
        "en": "Glow Passes (legacy, deprecated)",
        "zh-CN": "辉光层数（旧版弃用）"
      }
    },
    {
      "name": "sparkColor",
      "type": "Color",
      "default": "ff5a5a",
      "group": "Deprecated",
      "order": 108,
      "label": {
        "en": "Spark Color (legacy, deprecated)",
        "zh-CN": "颗粒颜色（旧版弃用）"
      }
    },
    {
      "name": "sparkOpacity",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 3,
      "group": "Deprecated",
      "order": 109,
      "label": {
        "en": "Spark Amount (legacy, deprecated)",
        "zh-CN": "颗粒强度（旧版弃用）"
      }
    },
    {
      "name": "displace",
      "type": "Float",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "group": "Deprecated",
      "order": 110,
      "label": {
        "en": "Coast Displacement (legacy, deprecated)",
        "zh-CN": "边缘偏移（旧版弃用）"
      }
    },
    {
      "name": "noiseBrightness",
      "type": "Float",
      "default": 1.0,
      "min": 0,
      "max": 3,
      "group": "Deprecated",
      "order": 111,
      "label": {
        "en": "Brightness (legacy, deprecated)",
        "zh-CN": "纹理亮度（旧版弃用）"
      }
    },
    {
      "name": "noiseSaturation",
      "type": "Float",
      "default": 1.0,
      "min": 0,
      "max": 3,
      "group": "Deprecated",
      "order": 112,
      "label": {
        "en": "Saturation (legacy, deprecated)",
        "zh-CN": "纹理饱和度（旧版弃用）"
      }
    },
    {
      "name": "noiseSampleRate",
      "type": "Float",
      "default": 1.0,
      "min": 0.25,
      "max": 4,
      "group": "Deprecated",
      "order": 113,
      "label": {
        "en": "Sample Rate (legacy, deprecated)",
        "zh-CN": "纹理尺寸（旧版弃用）"
      }
    },
    {
      "name": "lineOpacity",
      "type": "Float",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "group": "Deprecated",
      "order": 114,
      "label": {
        "en": "Grain Lines (legacy, deprecated)",
        "zh-CN": "横向噪线强度（旧版弃用）"
      }
    },
    {
      "name": "noiseFrameCount",
      "type": "Int",
      "default": 96,
      "min": 2,
      "max": 120,
      "group": "Deprecated",
      "order": 115,
      "label": {
        "en": "Frame Count (legacy, deprecated)",
        "zh-CN": "帧数（旧版弃用）"
      }
    },

{
  "schemaVersion": 1,
  "id": "pev.noise-field",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "main.js",
  "icon": "icon.png",
  "category": "DecorationFx",
  "decoration": true,
  "name": {
    "en": "Noise Field",
    "zh-CN": "噪声域"
  },
  "description": {
    "en": "A rectangular or circular region of scrolling red noise, placed as a decoration. Size, position, rotation, colour and opacity are the decoration's own; the parameters below shape the effect inside it.",
    "zh-CN": "矩形或圆形的滚动红色噪声区，作为装饰放置。位置、大小、旋转、颜色与透明度沿用装饰自身的属性；下列参数控制区域内部的观感。"
  },
  "params": [
    {
      "name": "shape",
      "type": "Enum:PEV.Scripting.NoiseFieldShape, PEV.Core",
      "default": "Rect",
      "group": "Geometry",
      "order": 0,
      "label": {
        "en": "Shape",
        "zh-CN": "形状"
      }
    },
    {
      "name": "feather",
      "type": "Float",
      "default": 0,
      "min": 0,
      "max": 8,
      "group": "Geometry",
      "order": 1,
      "showIf": [
        "shape",
        "Circle"
      ],
      "label": {
        "en": "Circle Softness",
        "zh-CN": "圆形羽化"
      }
    },
    {
      "name": "fillOpacity",
      "type": "Float",
      "default": 0.667,
      "min": 0,
      "max": 1,
      "group": "Layers",
      "order": 10,
      "label": {
        "en": "Fill Opacity",
        "zh-CN": "填充不透明度"
      }
    },
    {
      "name": "edgeColor",
      "type": "Color",
      "default": "ff5454",
      "group": "Layers",
      "order": 11,
      "label": {
        "en": "Edge Color",
        "zh-CN": "边框颜色"
      }
    },
    {
      "name": "edgeOpacity",
      "type": "Float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "group": "Layers",
      "order": 12,
      "label": {
        "en": "Edge Opacity",
        "zh-CN": "边框不透明度"
      }
    },
    {
      "name": "glowColor",
      "type": "Color",
      "default": "ff5454",
      "group": "Layers",
      "order": 13,
      "label": {
        "en": "Glow Color",
        "zh-CN": "辉光颜色"
      }
    },
    {
      "name": "glowOpacity",
      "type": "Float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "group": "Layers",
      "order": 14,
      "label": {
        "en": "Glow Opacity",
        "zh-CN": "辉光不透明度"
      }
    },
    {
      "name": "glowPasses",
      "type": "Float",
      "default": 5,
      "min": 0,
      "max": 6,
      "group": "Layers",
      "order": 15,
      "label": {
        "en": "Glow Passes",
        "zh-CN": "辉光层数"
      }
    },
    {
      "name": "sparkColor",
      "type": "Color",
      "default": "ff5a5a",
      "group": "Layers",
      "order": 16,
      "label": {
        "en": "Spark Color",
        "zh-CN": "颗粒颜色"
      }
    },
    {
      "name": "sparkOpacity",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 3,
      "group": "Layers",
      "order": 17,
      "label": {
        "en": "Spark Amount",
        "zh-CN": "颗粒数量"
      }
    },
    {
      "name": "displace",
      "type": "Float",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "group": "Layers",
      "order": 18,
      "label": {
        "en": "Coast Displacement",
        "zh-CN": "海岸偏移"
      }
    },
    {
      "name": "noiseBrightness",
      "type": "Float",
      "default": 1.0,
      "min": 0,
      "max": 3,
      "group": "Noise",
      "order": 20,
      "label": {
        "en": "Brightness",
        "zh-CN": "亮度"
      }
    },
    {
      "name": "noiseSaturation",
      "type": "Float",
      "default": 1.0,
      "min": 0,
      "max": 3,
      "group": "Noise",
      "order": 21,
      "label": {
        "en": "Saturation",
        "zh-CN": "饱和度"
      }
    },
    {
      "name": "noiseSampleRate",
      "type": "Float",
      "default": 1.0,
      "min": 0.25,
      "max": 4,
      "group": "Noise",
      "order": 22,
      "label": {
        "en": "Sample Rate",
        "zh-CN": "采样密度"
      }
    },
    {
      "name": "lineOpacity",
      "type": "Float",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "group": "Noise",
      "order": 23,
      "label": {
        "en": "Grain Lines",
        "zh-CN": "颗粒线条"
      }
    },
    {
      "name": "noiseFrameCount",
      "type": "Int",
      "default": 8,
      "min": 2,
      "max": 32,
      "group": "Noise",
      "order": 24,
      "label": {
        "en": "Frame Count",
        "zh-CN": "帧数"
      }
    },
    {
      "name": "noiseEvolveSpeed",
      "type": "Float",
      "default": 12,
      "min": 0,
      "max": 60,
      "unit": "fps",
      "group": "Noise",
      "order": 25,
      "label": {
        "en": "Evolve Speed",
        "zh-CN": "演变速度"
      }
    },
    {
      "name": "noiseMoveSpeed",
      "type": "Vector2",
      "default": [
        0.15,
        0
      ],
      "group": "Noise",
      "order": 26,
      "label": {
        "en": "Scroll Speed",
        "zh-CN": "滚动速度"
      }
    },
    {
      "name": "noiseScale",
      "type": "Vector2",
      "default": [
        1,
        1
      ],
      "group": "Noise",
      "order": 27,
      "label": {
        "en": "Grain Scale",
        "zh-CN": "颗粒缩放"
      }
    },
    {
      "name": "glitchRange",
      "type": "Float",
      "default": 0,
      "min": 0,
      "max": 1,
      "group": "Noise",
      "order": 28,
      "label": {
        "en": "Glitch",
        "zh-CN": "故障强度"
      }
    },
    {
      "name": "edgeDistance",
      "type": "Float",
      "default": 0.7,
      "min": 0,
      "max": 2,
      "group": "Edge",
      "order": 30,
      "label": {
        "en": "Edge Distance",
        "zh-CN": "边缘侵蚀距离"
      }
    },
    {
      "name": "edgeDetail",
      "type": "Float",
      "default": 8,
      "min": 1,
      "max": 32,
      "group": "Edge",
      "order": 31,
      "label": {
        "en": "Edge Detail",
        "zh-CN": "边缘细节密度"
      }
    },
    {
      "name": "edgeThickness",
      "type": "Int",
      "default": 1,
      "min": 1,
      "max": 6,
      "group": "Edge",
      "order": 32,
      "label": {
        "en": "Edge Thickness",
        "zh-CN": "边框厚度"
      }
    },
    {
      "name": "edgeMargin",
      "type": "Float",
      "default": 0.6,
      "min": 0,
      "max": 2,
      "group": "Edge",
      "order": 33,
      "label": {
        "en": "Fragment Margin",
        "zh-CN": "碎片留白"
      }
    },
    {
      "name": "edgeFragment",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 1,
      "group": "Edge",
      "order": 34,
      "label": {
        "en": "Fragment Amount",
        "zh-CN": "碎片数量"
      }
    },
    {
      "name": "preDuration",
      "type": "Float",
      "default": 0,
      "min": 0,
      "max": 5,
      "group": "Edge",
      "order": 35,
      "label": {
        "en": "Pre-Flash Duration",
        "zh-CN": "预警时长"
      }
    }
  ]
}

      "order": 123,
      "label": {
        "en": "Fragment Margin (legacy, deprecated)",
        "zh-CN": "碎片留白（旧版弃用）"
      }
    },
    {
      "name": "edgeFragment",
      "type": "Float",
      "default": 1,
      "min": 0,

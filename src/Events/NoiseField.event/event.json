{
  "schemaVersion": 4,
  "id": "pev.noise-field",
  "version": "1.34.0",
  "apiVersion": 2,
  "entry": "main.js",
  "icon": "icon.png",
  "category": "DecorationFx",
  "decoration": true,
  "hostPrimitive": "fx.field",
  "fieldPreview": {
    "key": "noisefield",
    "parameterMap": {}
  },
  "decorationDefaults": {
    "color": "ff5454",
    "tag": "noise"
  },
  "decorationMigration": [
    {
      "source": "size",
      "target": "scale",
      "conversion": "tilesToScale"
    },
    {
      "source": "positionOffset",
      "target": "position",
      "conversion": "vector2"
    },
    {
      "source": "rotation",
      "target": "rotation",
      "conversion": "float"
    },
    {
      "source": "tag",
      "target": "tag",
      "conversion": "string"
    },
    {
      "source": "depth",
      "target": "depth",
      "conversion": "int"
    },
    {
      "source": "opacity",
      "target": "opacity",
      "conversion": "percent"
    },
    {
      "source": "color",
      "target": "color",
      "conversion": "string"
    }
  ],
  "name": {
    "en": "Noise Field",
    "zh-CN": "噪声域"
  },
  "description": {
    "en": "A GPU noise field with adjustable coastline, outline and planet contact effects.",
    "zh-CN": "GPU 噪域，可调整海岸线、边缘和星球触点效果。"
  },
  "globalSettings": [
    {
      "name": "captureScene",
      "type": "Bool",
      "default": true,
      "label": {
        "en": "Realtime scene sampling (disable for better performance)",
        "zh-CN": "实时场景采样（关闭可提高性能）"
      }
    }
  ],
  "params": [
    {
      "name": "invert",
      "type": "Bool",
      "default": false,
      "group": "Geometry",
      "order": 0,
      "label": {
        "en": "Invert Region",
        "zh-CN": "反转区域"
      }
    },
    {
      "name": "coastWidth",
      "type": "Float",
      "default": 0.5,
      "min": 0,
      "max": 4,
      "group": "DepthStyle",
      "order": 1,
      "label": {
        "en": "Coastline Width (World)",
        "zh-CN": "海岸线宽度（世界单位）"
      }
    },
    {
      "name": "outlineWidth",
      "type": "Float",
      "default": 0.045,
      "min": 0.005,
      "max": 0.5,
      "group": "DepthStyle",
      "order": 2,
      "label": {
        "en": "Outline Width (World)",
        "zh-CN": "边缘宽度（世界单位）"
      }
    },
    {
      "name": "touchOpacity",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 1,
      "group": "DepthStyle",
      "order": 3,
      "label": {
        "en": "Contact Opacity",
        "zh-CN": "触点透明度"
      }
    },
    {
      "name": "touchSize",
      "type": "Float",
      "default": 1,
      "min": 0.1,
      "max": 3,
      "group": "DepthStyle",
      "order": 4,
      "label": {
        "en": "Contact Size",
        "zh-CN": "触点大小"
      }
    }
  ],
  "shaderBundle": "assets/noise-field.bundle",
  "includedEvents": [
    "included/state.json"
  ],
  "vectorPrograms": {
    "palette": "workers/palette.js",
    "contacts": "workers/contacts.js",
    "renderPlan": "workers/render-plan.js",
    "renderGroup": "workers/render-group.js",
    "bake": "workers/legacy-bake.js",
    "bakePlan": "workers/legacy-plan.js",
    "frameRequest": "workers/frame-request.js"
  },
  "computeGraphs": {
    "coverage": "pipelines/coverage.json"
  },
  "keySpecs": {
    "frames": "pipelines/cpu-key.json"
  },
  "runtimeBindings": {
    "renderGraph": "coverage",
    "renderPlan": "renderPlan",
    "renderGroup": "renderGroup",
    "inputController": "contacts",
    "vectorProgram": "palette",
    "framePlan": "bakePlan",
    "frameProgram": "bake",
    "frameKey": "frames",
    "frameRequest": "frameRequest"
  },
  "pixelResources": {
    "block": "assets/legacy/block.png",
    "point": "assets/legacy/point.png"
  },
  "shaderAssets": {
    "compute": "assets/noisefieldcoverage.compute",
    "disabled": "assets/generated/PEVNoise_100_disabled.shader",
    "activeCapture": "assets/generated/PEVNoise_000_capture.shader",
    "hoverCapture": "assets/generated/PEVNoise_010_capture.shader",
    "activeNoCapture": "assets/generated/PEVNoise_000_nocapture.shader",
    "hoverNoCapture": "assets/generated/PEVNoise_010_nocapture.shader",
    "disabledColored": "assets/generated/PEVNoise_101_disabled.shader",
    "activeCaptureColored": "assets/generated/PEVNoise_001_capture.shader",
    "hoverCaptureColored": "assets/generated/PEVNoise_011_capture.shader",
    "activeNoCaptureColored": "assets/generated/PEVNoise_001_nocapture.shader",
    "hoverNoCaptureColored": "assets/generated/PEVNoise_011_nocapture.shader"
  },
  "imageAssets": {
    "displacement": {
      "path": "assets/BlockNoise1.png",
      "wrap": "mirror",
      "filter": "point",
      "flipY": true,
      "linear": true
    },
    "spark": {
      "path": "assets/PointNoise.png",
      "wrap": "repeat",
      "filter": "point",
      "flipY": true,
      "linear": true
    },
    "noise": {
      "path": "assets/FD_Noise_00000.png",
      "wrap": "mirror",
      "filter": "point",
      "flipY": true,
      "linear": true
    },
    "touch": {
      "path": "assets/TouchHover.png",
      "wrap": "clamp",
      "filter": "linear",
      "flipY": true,
      "linear": true
    }
  },
  "hiddenDecorationProperties": [
    "blendMode"
  ]
}

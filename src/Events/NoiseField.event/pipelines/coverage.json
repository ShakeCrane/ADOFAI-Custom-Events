      },
      {
        "name": "_TouchPos",
        "type": "vectorArray",
        "input": "contacts",
        "when": {
          "hasContacts": true
        }
      }
    ],
    "layers": [
      {
        "name": "secondary",
        "order": 0,
        "visible": "showSecondary",
        "variants": [
          {
            "shader": "disabledColored",
            "when": {

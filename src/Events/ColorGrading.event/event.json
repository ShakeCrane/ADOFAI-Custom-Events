      "group": "Wheels",
      "label": {
        "en": "Lift colour",
        "zh-CN": "提升色相"
      }
    },
    {
      "name": "liftL",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Wheels",
      "order": 1,
      "label": {
        "en": "Lift luma",
        "zh-CN": "提升亮度"
      }
    },
    {
      "name": "gammaXY",
      "type": "Vector2",
      "default": [
        0,
        0
      ],
      "group": "Wheels",
      "order": 2,
      "label": {
        "en": "Gamma colour",
        "zh-CN": "中间调色相"
      }
    },
    {
      "name": "gammaL",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,

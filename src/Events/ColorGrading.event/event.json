{
  "schemaVersion": 5,
  "id": "pev.color-grading",
  "version": "1.0.0",
  "apiVersion": 2,
  "entry": "main.js",
  "icon": "icon.png",
  "category": "VisualFx",
  "name": {
    "en": "Color Grading",
    "zh-CN": "调色"
  },
  "description": {
    "en": "Professional colour grading for the whole game picture: exposure, tone, curves, four-way colour wheels, LUTs and HSL ranges, animated on the song timeline.",
    "zh-CN": "对整个游戏画面做专业调色：曝光、影调、曲线、四向色轮、LUT 与 HSL 分区间，可随时间轴动画。"
  },
  "shaderBundle": "assets/color-grading.bundle",
  "shaderAssets": {
    "grade": "ColorGrading"
  },
  "screenEffect": {
    "shader": "grade"
  },
  "editorPanel": {
    "title": {
      "en": "Color Grading",
      "zh-CN": "调色"
    },
    "curves": {
      "master": "curveMaster",
      "red": "curveRed",
      "green": "curveGreen",
      "blue": "curveBlue"
    },
    "hueCurves": {
      "hue": "hueVsHue",
      "saturation": "hueVsSat",
      "luma": "hueVsLuma"
    },
    "wheels": [
      {
        "label": {
          "en": "Lift",
          "zh-CN": "提升"
        },
        "xy": "liftXY",
        "luma": "liftL"
      },
      {
        "label": {
          "en": "Gamma",
          "zh-CN": "中间调"
        },
        "xy": "gammaXY",
        "luma": "gammaL"
      },
      {
        "label": {
          "en": "Gain",
          "zh-CN": "增益"
        },
        "xy": "gainXY",
        "luma": "gainL"
      },
      {
        "label": {
          "en": "Offset",
          "zh-CN": "全局偏移"
        },
        "xy": "offsetXY",
        "luma": "offsetL"
      }
    ],
    "lut": {
      "preset": "lutPreset",
      "file": "lutFile",
      "strength": "lutStrength"
    },
    "compare": "enabled"
  },
  "params": [
    {
      "name": "enabled",
      "type": "Bool",
      "default": true,
      "group": "Basic",
      "label": {
        "en": "Enable grade",
        "zh-CN": "启用调色"
      }
    },
    {
      "name": "strength",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 1,
      "group": "Basic",
      "order": 1,
      "label": {
        "en": "Strength",
        "zh-CN": "强度"
      }
    },
    {
      "name": "mode",
      "type": "Choice",
      "default": "Replace",
      "options": [
        "Replace",
        "Stack"
      ],
      "optionLabels": {
        "Replace": {
          "en": "Replace previous",
          "zh-CN": "替换前一个"
        },
        "Stack": {
          "en": "Stack on previous",
          "zh-CN": "叠加在前一个上"
        }
      },
      "group": "Basic",
      "order": 2,
      "label": {
        "en": "Combine",
        "zh-CN": "组合方式"
      }
    },
    {
      "name": "duration",
      "type": "Float",
      "default": 0,
      "min": 0,
      "max": 64,
      "unit": "beats",
      "group": "Basic",
      "order": 3,
      "label": {
        "en": "Fade in",
        "zh-CN": "渐变时长"
      }
    },
    {
      "name": "ease",
      "type": "Choice",
      "default": "OutCubic",
      "options": [
        "Linear",
        "InSine",
        "OutSine",
        "InOutSine",
        "InQuad",
        "OutQuad",
        "InOutQuad",
        "InCubic",
        "OutCubic",
        "InOutCubic",
        "OutExpo"
      ],
      "group": "Basic",
      "order": 4,
      "label": {
        "en": "Ease",
        "zh-CN": "缓动"
      }
    },
    {
      "name": "exposure",
      "type": "Float",
      "default": 0,
      "min": -5,
      "max": 5,
      "group": "Basic",
      "order": 10,
      "label": {
        "en": "Exposure",
        "zh-CN": "曝光"
      },
      "unit": "stops"
    },
    {
      "name": "brightness",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Basic",
      "order": 11,
      "label": {
        "en": "Brightness",
        "zh-CN": "亮度"
      }
    },
    {
      "name": "contrast",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Basic",
      "order": 12,
      "label": {
        "en": "Contrast",
        "zh-CN": "对比度"
      }
    },
    {
      "name": "saturation",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Basic",
      "order": 13,
      "label": {
        "en": "Saturation",
        "zh-CN": "饱和度"
      }
    },
    {
      "name": "vibrance",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Basic",
      "order": 14,
      "label": {
        "en": "Vibrance",
        "zh-CN": "自然饱和度"
      }
    },
    {
      "name": "temperature",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Basic",
      "order": 15,
      "label": {
        "en": "Temperature",
        "zh-CN": "色温"
      }
    },
    {
      "name": "tint",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Basic",
      "order": 16,
      "label": {
        "en": "Tint",
        "zh-CN": "色调"
      }
    },
    {
      "name": "highlights",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Tone",
      "label": {
        "en": "Highlights",
        "zh-CN": "高光"
      }
    },
    {
      "name": "shadows",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Tone",
      "order": 1,
      "label": {
        "en": "Shadows",
        "zh-CN": "阴影"
      }
    },
    {
      "name": "whites",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Tone",
      "order": 2,
      "label": {
        "en": "Whites",
        "zh-CN": "白色阶"
      }
    },
    {
      "name": "blacks",
      "type": "Float",
      "default": 0,
      "min": -1,
      "max": 1,
      "group": "Tone",
      "order": 3,
      "label": {
        "en": "Blacks",
        "zh-CN": "黑色阶"
      }
    },
    {
      "name": "gamma",
      "type": "Float",
      "default": 1,
      "min": 0.2,
      "max": 5,
      "group": "Tone",
      "order": 4,
      "label": {
        "en": "Gamma",
        "zh-CN": "伽马"
      }
    },
    {
      "name": "gainR",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 4,
      "group": "Channels",
      "label": {
        "en": "Red gain",
        "zh-CN": "红增益"
      }
    },
    {
      "name": "gainG",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 4,
      "group": "Channels",
      "order": 1,
      "label": {
        "en": "Green gain",
        "zh-CN": "绿增益"
      }
    },
    {
      "name": "gainB",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 4,

      "order": 2,
      "label": {
        "en": "Blue gain",
        "zh-CN": "蓝增益"
      }
    },
    {
      "name": "offsetR",
      "type": "Float",
      "default": 0,
      "min": -0.5,
      "max": 0.5,
      "group": "Channels",
      "order": 3,
      "label": {
        "en": "Red offset",
        "zh-CN": "红偏移"
      }
    },
    {
      "name": "offsetG",
      "type": "Float",
      "default": 0,
      "min": -0.5,
      "max": 0.5,
      "group": "Channels",
      "order": 4,
      "label": {
        "en": "Green offset",
        "zh-CN": "绿偏移"
      }
    },
    {
      "name": "offsetB",
      "type": "Float",
      "default": 0,
      "min": -0.5,
      "max": 0.5,
      "group": "Channels",
      "order": 5,
      "label": {
        "en": "Blue offset",
        "zh-CN": "蓝偏移"
      }
    },
    {
      "name": "liftXY",
      "type": "Vector2",
      "default": [
        0,
        0

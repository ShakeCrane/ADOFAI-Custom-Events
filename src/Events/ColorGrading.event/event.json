    {
      "name": "lutPreset",
      "type": "Choice",
      "default": "None",
      "options": [
        "None",
        "BundledTealOrange",
        "BundledBleachBypass",
        "BundledWarmFilm"
      ],
      "optionLabels": {
        "None": {
          "en": "None",
          "zh-CN": "无"
        },
        "BundledTealOrange": {
          "en": "Teal & Orange",
          "zh-CN": "青橙"
        },
        "BundledBleachBypass": {
          "en": "Bleach Bypass",
          "zh-CN": "漂白"
        },
        "BundledWarmFilm": {
          "en": "Warm Film",
          "zh-CN": "暖胶片"
        }
      },
      "group": "LUT",
      "label": {
        "en": "Built-in LUT",
        "zh-CN": "内置 LUT"
      }
    },
    {
      "name": "lutFile",
      "type": "String",
      "default": "",
      "group": "LUT",
      "order": 1,
      "label": {
        "en": "LUT file (.cube)",
        "zh-CN": "LUT 文件（.cube）"
      }
    },
    {
      "name": "lutStrength",
      "type": "Float",
      "default": 1,
      "min": 0,
      "max": 1,
      "group": "LUT",
      "order": 2,
      "label": {
        "en": "LUT strength",
        "zh-CN": "LUT 强度"
      }
    },
    {
      "name": "showRaw",
      "type": "Bool",
      "default": false,
      "group": "HSL",
      "order": 1,
      "label": {

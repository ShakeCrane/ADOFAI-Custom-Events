{
  "schemaVersion": 1,
  "id": "pev.camera-warp",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "main.js",
  "icon": "icon.png",
  "category": "VisualFx",
  "name": { "en": "Camera Warp", "zh-CN": "镜头扭曲" },
  "description": {
    "en": "Combines a flash and a camera shake for the specified number of beats.",
    "zh-CN": "在指定拍数内叠加闪光与镜头震动。"
  },
  "params": [
    { "name": "strength", "type": "Float", "default": 0.8, "min": 0, "max": 2, "unit": "x" },
    { "name": "duration", "type": "Float", "default": 2, "min": 0, "max": 16, "unit": "beats" },
    { "name": "ease", "type": "Enum:Ease", "default": "OutQuad",
      "label": { "en": "Ease (editor control sample)", "zh-CN": "缓动（控件示例）" } },
    { "name": "color", "type": "Color", "default": "ffffff" }
  ]
}

{
  "schemaVersion": 1,
  "id": "pev.move-noise-field",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "main.js",
  "icon": "icon.png",
  "category": "DecorationFx",
  "name": {
    "en": "Move Noise Field",
    "zh-CN": "移动噪声域"
  },
  "description": {
    "en": "Moves every Noise Field carrying the given tag. Offset is in tiles. Press play to preview.",
    "zh-CN": "移动所有带有指定 tag 的噪声域。偏移单位为方块。按播放预览。"
  },
  "params": [
    { "name": "tag", "type": "String", "default": "", "group": "Target" },
    { "name": "duration", "type": "Float", "default": 1, "min": 0, "max": 32, "unit": "s", "group": "Motion" },
    { "name": "ease", "type": "Enum:Ease", "default": "OutQuad", "group": "Motion" },
    { "name": "offset", "type": "Vector2", "default": [0, 0], "group": "Motion" },
    { "name": "rotation", "type": "Float", "default": 0, "min": -180, "max": 180, "group": "Motion" },
    { "name": "scale", "type": "Float", "default": 1, "min": 0.01, "max": 8, "group": "Motion" },
    { "name": "alpha", "type": "Float", "default": 1, "min": 0, "max": 1, "group": "Motion" }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PEV.Core</AssemblyName>
    <RootNamespace>PEV</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>CS0436;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>D:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice</GameDir>
    <ManagedDir>$(GameDir)\A Dance of Fire and Ice_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference noise textures, taken verbatim from Phira-Pro's noise-skins/NoiseField/tex
      (GPL-3.0-or-later, compatible with this project's AGPL-3.0). The effect's whole
      displacement and grain character comes from these specific images: their pixel
      statistics are not reproducible by an analytic noise function, which is why every
      attempt to synthesise a substitute looked wrong.
    -->
    <EmbeddedResource Include="Textures\BlockNoise1.png" />
    <EmbeddedResource Include="Textures\PointNoise.png" />
    <EmbeddedResource Include="Textures\FD_Noise.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(ManagedDir)\RDTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression">
      <HintPath>$(ManagedDir)\System.IO.Compression.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem">
      <HintPath>$(ManagedDir)\System.IO.Compression.FileSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(ManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\UnityModManager\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jint">
      <HintPath>..\..\packages\jint-lib\Jint.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Acornima">
      <HintPath>..\..\packages\jint-lib\Acornima.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>

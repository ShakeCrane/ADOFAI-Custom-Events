<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PEV.Core</AssemblyName>
    <RootNamespace>PEV</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>CS0436;CS0618</NoWarn>
    <IncludeDiagnostics Condition="'$(IncludeDiagnostics)' == ''">false</IncludeDiagnostics>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);PEV_DIAGNOSTICS</DefineConstants>
    <OutputPath>bin\$(Configuration)-diagnostics\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)-diagnostics\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeDiagnostics)' != 'true'">
    <Compile Remove="Diagnostics\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(ADOFAI_GAME_DIR)</GameDir>
    <ManagedDir>$(GameDir)\A Dance of Fire and Ice_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(ManagedDir)\RDTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression">
      <HintPath>$(ManagedDir)\System.IO.Compression.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem">
      <HintPath>$(ManagedDir)\System.IO.Compression.FileSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(ManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\UnityModManager\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jint">
      <HintPath>..\..\packages\jint-lib\Jint.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Acornima">
      <HintPath>..\..\packages\jint-lib\Acornima.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckLocalBuildInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll') Or !Exists('$(ManagedDir)\UnityModManager\UnityModManager.dll')"
           Text="Set ADOFAI_GAME_DIR to your local ADOFAI installation with Unity Mod Manager installed." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\packages\jint-lib\Jint.dll') Or !Exists('$(MSBuildProjectDirectory)\..\..\packages\jint-lib\Acornima.dll')"
           Text="Restore the local build dependencies with python tools/restore_dependencies.py." />
  </Target>

</Project>
